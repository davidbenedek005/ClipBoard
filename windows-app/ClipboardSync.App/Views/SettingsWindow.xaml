<Window x:Class="ClipboardSync.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ClipboardSync.App.Services"
        Title="ClipBoard"
        Height="640"
        Width="520"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type svc:TextHistoryEntry}">
            <Border Margin="0,0,0,10" Padding="16" Background="White" CornerRadius="16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="12,6" Content="Copy" Click="CopyText_Click" />
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#5C6B7A" Text="{Binding TimeLabel}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding Direction}" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Text}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type svc:ImageHistoryEntry}">
            <Border Margin="0,0,0,10" Padding="16" Background="White" CornerRadius="16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="12,6" Content="Copy image" Click="CopyImage_Click" />
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#5C6B7A" Text="{Binding TimeLabel}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding Direction}" />
                        <Image Margin="0,8,0,0" MaxHeight="180" Stretch="Uniform" Source="{Binding Thumbnail}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="ClipBoard" />
            <TextBlock Margin="0,4,0,16" Foreground="#5C6B7A" Text="What has moved between this PC and the phone." />
            <CheckBox x:Name="SyncImagesBox" Content="Sync images as well as text" Checked="OnImagesChanged" Unchecked="OnImagesChanged" />
            <Button Margin="0,12,0,0" HorizontalAlignment="Left" Padding="14,8" Content="Disconnect the phone" Click="OnDisconnect" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryList" />
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="ClipboardSync.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ClipboardSync.App.Services"
        Title="ClipBoard"
        Width="980"
        Height="700"
        MinWidth="760"
        MinHeight="520"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type svc:TextHistoryEntry}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,2">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Direction}" />
                            </Border>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding TimeLabel}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" MaxHeight="120" TextTrimming="CharacterEllipsis" Text="{Binding Text}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button Style="{StaticResource SubtleButton}" Content="Copy" Click="CopyText_Click" />
                        <Button Margin="6,0,0,0" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                ToolTip="Delete" Click="DeleteEntry_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type svc:ImageHistoryEntry}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,2">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Direction}" />
                            </Border>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding TimeLabel}" />
                        </StackPanel>
                        <Border Margin="0,12,0,0" CornerRadius="10" HorizontalAlignment="Left" ClipToBounds="True">
                            <Image MaxHeight="220" MaxWidth="420" Stretch="Uniform" Source="{Binding Thumbnail}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button Style="{StaticResource SubtleButton}" Content="Copy image" Click="CopyImage_Click" />
                        <Button Margin="6,0,0,0" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                ToolTip="Delete" Click="DeleteEntry_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type svc:FileHistoryEntry}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FileBadge}" VerticalAlignment="Top">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Text="{Binding ExtensionLabel}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,2">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Direction}" />
                            </Border>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding TimeLabel}" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="{Binding FileName}" ToolTip="{Binding FilePath}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding SizeLabel}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button Style="{StaticResource SubtleButton}" Content="Open" Click="OpenFile_Click" />
                        <Button Margin="6,0,0,0" Style="{StaticResource SubtleButton}" Content="Show in folder" Click="ShowInFolder_Click" />
                        <Button Margin="6,0,0,0" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                ToolTip="Delete" Click="DeleteEntry_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TransferTemplate" DataType="{x:Type svc:FileTransfer}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding FileName}" />
                        <ProgressBar Margin="0,10,0,8" Style="{StaticResource SlimProgress}" Value="{Binding Percent, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                    </StackPanel>
                    <Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource SubtleButton}"
                            Content="Cancel" Visibility="{Binding CancelVisibility}" Click="CancelTransfer_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" AllowDrop="True"
          DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="16,24,16,20">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,28">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="ClipBoard" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#9AA4B1" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Margin="8,0,0,0" Style="{StaticResource Caption}" Text="Waiting for a device" />
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True"
                                 Content="Sync history" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavPairing" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="Pairing" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="Settings" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <!-- Sync history -->
            <DockPanel x:Name="HistoryPage" Margin="36,32,36,24">
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Sync history" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Text, images, and files that moved between this PC and your phone. Drop files here to send them." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,6,10,0" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button x:Name="ClearHistoryButton" Style="{StaticResource SubtleButton}" Click="ClearHistory_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Clear history" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Style="{StaticResource AccentButton}" Click="SendFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8A5;"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Send file" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <ItemsControl x:Name="TransferList" DockPanel.Dock="Top" Margin="2,2,10,0"
                              ItemTemplate="{StaticResource TransferTemplate}" />
                <Grid>
                    <TextBlock x:Name="HistoryEmpty" Style="{StaticResource Caption}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Nothing synced yet. Copy something on this PC, tap Send to PC on the phone, or drop a file here." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <ItemsControl x:Name="HistoryList" Margin="2,2,2,8" />
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- Pairing -->
            <ScrollViewer x:Name="PairingPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,32,36,32">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Pairing" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Scan the code with the phone camera, or type the connection details in ClipBoard on the phone." />
                    <WrapPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,20,20" Padding="24">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Scan with the phone" />
                                <TextBlock x:Name="AddressHint" Margin="0,4,0,16" MaxWidth="320" Style="{StaticResource Caption}" />
                                <Border Background="White" Padding="12" CornerRadius="8" HorizontalAlignment="Center">
                                    <Image x:Name="QrImage" Width="320" Height="320" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="24" Width="340" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Manual connection" />
                                <TextBlock Margin="0,4,0,16" Style="{StaticResource Caption}" Text="Enter these values on the phone." />
                                <TextBlock Style="{StaticResource Caption}" Text="IP address" />
                                <TextBox x:Name="IpText" Margin="0,4,0,12" Style="{StaticResource ReadOnlyField}" />
                                <TextBlock Style="{StaticResource Caption}" Text="Port" />
                                <TextBox x:Name="PortText" Margin="0,4,0,12" Style="{StaticResource ReadOnlyField}" />
                                <TextBlock Style="{StaticResource Caption}" Text="Pairing token" />
                                <TextBox x:Name="TokenText" Margin="0,4,0,16" Style="{StaticResource ReadOnlyField}" FontSize="12" />
                                <Button HorizontalAlignment="Left" Style="{StaticResource SubtleButton}"
                                        Content="New pairing code" Click="Regenerate_Click" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock MaxWidth="680" HorizontalAlignment="Left" Style="{StaticResource Caption}"
                               Text="If the phone never connects, allow ClipBoard through Windows Firewall for private networks. Clipboard contents are encrypted with AES-256-GCM." />

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" MaxWidth="680" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Nearby PCs" />
                            <TextBlock Margin="0,4,0,12" Style="{StaticResource Caption}"
                                       Text="Pick another PC running ClipBoard. It will show a 6-digit PIN. Enter that PIN here. Phones still use the QR code above." />
                            <ListBox x:Name="HubList" Height="150" DisplayMemberPath="Label" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource AccentButton}" Content="Connect" Click="JoinHub_Click" />
                                <Button Margin="8,0,0,0" Style="{StaticResource SubtleButton}" Content="Refresh" Click="ProbeHubs_Click" />
                                <Button Margin="8,0,0,0" Style="{StaticResource SubtleButton}" Content="Leave" Click="LeaveHub_Click" />
                            </StackPanel>
                            <StackPanel x:Name="PinEntry" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock x:Name="PinHint" Style="{StaticResource Caption}" Text="PIN shown on the other PC" />
                                <TextBox x:Name="PinBox" Margin="0,6,0,10" MaxLength="6" FontSize="22" Padding="10,6" />
                                <Button HorizontalAlignment="Left" Style="{StaticResource AccentButton}" Content="Pair" Click="SubmitPin_Click" />
                            </StackPanel>
                            <TextBlock x:Name="HubStatus" Margin="0,12,0,0" Style="{StaticResource Caption}" Text="Not joined to another PC." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,32,36,32" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Choose what syncs and how ClipBoard starts." />

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Name on other devices" />
                            <TextBlock Margin="0,4,0,8" Style="{StaticResource Caption}"
                                       Text="Phones and PCs show this name next to clipboard items you send." />
                            <TextBox x:Name="DeviceNameBox" Padding="10,8" LostFocus="DeviceName_LostFocus" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Sync images" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                                           Text="Images are resized to 1600 px and kept under 5 MB. Text always syncs." />
                            </StackPanel>
                            <CheckBox x:Name="SyncImagesToggle" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}" Click="SyncImages_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Start with Windows" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                                           Text="Launch ClipBoard in the tray when you sign in." />
                            </StackPanel>
                            <CheckBox x:Name="AutoStartToggle" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}" Click="AutoStart_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Connected phone" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                                           Text="Close the connection to the phone. It stays paired and can connect again." />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubtleButton}"
                                    Content="Disconnect" Click="Disconnect_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#CCF3F5F8" Padding="24">
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="16"
                    Background="#14005FB8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40"
                               Foreground="{StaticResource AccentBrush}" Text="&#xE898;" />
                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                               Text="Drop to send to your phone" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

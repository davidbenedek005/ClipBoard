<Window x:Class="ClipboardSync.App.Views.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair this PC"
        Height="820"
        Width="480"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Scan with the phone" />
            <TextBlock x:Name="AddressText" Margin="0,8,0,12" TextWrapping="Wrap" />
            <Border Background="White" Padding="32" HorizontalAlignment="Center">
                <Image x:Name="QrImage" Width="360" Height="360" Stretch="Uniform" />
            </Border>
            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="Or type these on the phone" />
            <TextBlock Margin="0,8,0,2" Text="IP address" />
            <TextBox x:Name="IpText" IsReadOnly="True" FontSize="16" Padding="6" />
            <TextBlock Margin="0,8,0,2" Text="Port" />
            <TextBox x:Name="PortText" IsReadOnly="True" FontSize="16" Padding="6" />
            <TextBlock Margin="0,8,0,2" Text="Pairing token" />
            <TextBox x:Name="TokenText" IsReadOnly="True" FontSize="14" Padding="6" TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="If the phone never connects, allow ClipBoard through Windows Firewall for private networks. The WebSocket is cleartext on the LAN. The clipboard bytes inside it are AES-256-GCM." />
            <Button Margin="0,16,0,0" Padding="12,6" HorizontalAlignment="Left"
                    Content="New pairing code" Click="Regenerate_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
